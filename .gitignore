# consema-kt: minimal .gitignore for the split repository.
build/
.gradle/
*.class
*.jar

# Provisioned conformance data: the single authority is the consema spec
# repository (CI provisions conformance/ + docs/fc-manifest-0.13.0.json into
# the workspace root); a committed copy here would fork the authority.
# Anchored at the repository root (/conformance/, /docs/...): the provisioned
# data directory only. kotlin/src/main/kotlin/consema/conformance/ (source)
# must stay trackable — an unanchored pattern would silently ignore new
# runner source files.
/conformance/
/docs/fc-manifest-0.13.0.json

# IDE / OS artifacts
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Build outputs (repo root; gradle build/ covered under kotlin/)
target/
kotlin/.kotlin/
